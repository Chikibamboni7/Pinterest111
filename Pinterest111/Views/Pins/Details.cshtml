@{
    ViewData["Title"] = "Pin";
}

<div class="row">
    <div class="col-md-8">
        <img src="https://picsum.photos/seed/pin/900/600" class="img-fluid rounded" />
        <div class="mt-3">
            <h4>Название пина</h4>
            <p class="text-muted">Описание пина — короткий текст с идеей.</p>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-danger">❤ 34</button>
                <button class="btn btn-outline-secondary">Сохранить</button>
                <a class="btn btn-link" asp-controller="Profile" asp-action="Index" asp-route-username="author">author</a>
            </div>
        </div>
        <hr />
        <h5>Комментарии</h5>
        <div>
            <div class="mb-2"><strong>user1</strong> Отличная идея!</div>
            <div class="mb-2"><strong>user2</strong> Попробую сделать.</div>
        </div>
        <div class="mt-3">
            <textarea class="form-control mb-2" placeholder="Добавить комментарий (UI only)"></textarea>
            <button class="btn btn-primary">Отправить</button>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3">
            <h6>Создать доску</h6>
            <div class="mb-2">
                <input class="form-control" placeholder="Название доски" />
            </div>
            <button class="btn btn-outline-secondary">Создать (UI only)</button>
        </div>
    </div>
</div>