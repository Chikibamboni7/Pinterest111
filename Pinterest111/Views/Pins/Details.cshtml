@model Pinterest111.Models.Pin
@{
    ViewData["Title"] = Model.Title;
}

<div class="row">
    <div class="col-md-8">
        <img src="@Model.ImageUrl" class="img-fluid rounded" />
        <div class="mt-3">
            <h4>@Model.Title</h4>
            <p class="text-muted">@Model.Description</p>
            <div class="d-flex gap-2 align-items-center">
                <a class="btn btn-link" asp-controller="Profile" asp-action="Index" asp-route-username="@Model.Author">@Model.Author</a>
                <span class="text-muted small">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
            </div>

            @if (string.Equals(User.Identity?.Name, Model.Author, StringComparison.OrdinalIgnoreCase))
            {
                <form asp-controller="Pins" asp-action="Delete" asp-route-id="@Model.Id" method="post"
                      class="mt-3" onsubmit="return confirm('Удалить этот пин? Это действие необратимо.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm">Удалить пин</button>
                </form>
            }
        </div>
    </div>
</div>

@using Pinterest111.Models
@inject Pinterest111.Services.FileBoardStore BoardStore

@if (User.Identity?.IsAuthenticated == true)
{
    var userBoards = BoardStore.GetByAuthor(User.Identity.Name!);
    if (userBoards.Any())
    {
        <form asp-controller="Boards" asp-action="AddPin" method="post" class="mt-3 d-flex gap-2 align-items-start">
            @Html.AntiForgeryToken()
            <input type="hidden" name="pinId" value="@Model.Id" />
            <select name="boardId" class="form-select form-select-sm" style="max-width:320px;">
                @foreach (var b in userBoards)
                {
                    <option value="@b.Id">@b.Title (@(b.PinIds?.Count ?? 0))</option>
                }
            </select>
            <button type="submit" class="btn btn-sm btn-primary">Сохранить в доску</button>
        </form>
    }
    else
    {
        <div class="mt-3">
            <a class="btn btn-sm btn-outline-primary" asp-controller="Boards" asp-action="Create">Создать доску, чтобы сохранить пин</a>
        </div>
    }
}
