@model Pinterest111.Models.PinCreateViewModel
@{
    ViewData["Title"] = "Добавить Pin";
}

<h3 class="mb-3">Добавить пост</h3>

<div class="row justify-content-center">
    <div class="col-md-6">
        <form asp-controller="Pins" asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger mb-2"></div>

            <div class="mb-2">
                <input asp-for="Title" class="form-control" placeholder="Название" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="mb-2">
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Описание"></textarea>
            </div>
            <div class="mb-2">
                <input asp-for="Image" accept="image/*" class="form-control" />
                <span asp-validation-for="Image" class="text-danger small"></span>
            </div>
            <div class="d-grid">
                <button type="submit" class="btn btn-primary">Опубликовать</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
