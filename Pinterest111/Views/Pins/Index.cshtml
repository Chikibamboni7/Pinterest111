@model List<Pinterest111.Models.Pin>
@{
    ViewData["Title"] = "Все пины";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Все пины</h3>
    <a class="btn btn-primary" asp-controller="Pins" asp-action="Create">Добавить</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Пока нет ни одного пина. Будьте первым!</p>
}

<div class="pin-grid">
    @foreach (var pin in Model)
    {
        @await Html.PartialAsync("_PinCard", pin)
    }
</div>
