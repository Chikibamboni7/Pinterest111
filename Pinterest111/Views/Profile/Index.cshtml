@model Pinterest111.Models.ProfileViewModel
@{
    ViewData["Title"] = Model.User.Username;
}

<div class="profile-header mb-3 d-flex align-items-center gap-3">
    <img src="@Model.User.AvatarUrl" class="profile-avatar" width="80" height="80" />
    <div>
        <h4 class="mb-0">@Model.User.Username</h4>
        <div class="text-muted">@Model.User.FullName</div>

        @if (!string.IsNullOrWhiteSpace(Model.User.Bio))
        {
            <p class="mt-2 mb-0">@Model.User.Bio</p>
        }

        <div class="mt-2">
            @if (Model.IsOwnProfile)
            {
                <a class="btn btn-outline-secondary btn-sm" asp-controller="Profile" asp-action="Edit">Редактировать профиль</a>
            }
            else
            {
                <button class="btn btn-outline-primary btn-sm">Подписаться</button>
            }
        </div>
    </div>
</div>

<h5 class="mb-3">Пины пользователя</h5>

@if (!Model.Pins.Any())
{
    <p class="text-muted">Пока нет пинов.</p>
}

<div class="pin-grid">
    @foreach (var pin in Model.Pins)
    {
        @await Html.PartialAsync("_PinCard", pin)
    }
</div>
