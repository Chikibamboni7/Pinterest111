@model Pinterest111.Models.SearchResultsViewModel
@{
    ViewData["Title"] = "Поиск";
}

<h3>Результаты поиска: «@Model.Query»</h3>

@if (string.IsNullOrWhiteSpace(Model.Query))
{
    <p class="text-muted">Введите запрос в поиске сверху.</p>
}
else if (!Model.Pins.Any() && !Model.Users.Any())
{
    <p class="text-muted">Ничего не найдено.</p>
}
else
{
    <div class="row">
        <div class="col-md-8">
            <h5>Пины</h5>
            @if (!Model.Pins.Any())
            {
                <p class="text-muted">Пины не найдены.</p>
            }
            <div class="pin-grid">
                @foreach (var pin in Model.Pins)
                {
                    @await Html.PartialAsync("_PinCard", pin)
                }
            </div>
        </div>
        <div class="col-md-4">
            <h5>Пользователи</h5>
            @if (!Model.Users.Any())
            {
                <p class="text-muted">Пользователи не найдены.</p>
            }
            <ul class="list-group">
                @foreach (var user in Model.Users)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <a asp-controller="Profile" asp-action="Index" asp-route-username="@user.Username">
                            @user.Username <span class="text-muted">(@user.FullName)</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
}