@{
    ViewData["Title"] = "Поиск";
    var q = Context.Request.Query["q"].ToString();
}

<h3>Результаты поиска: «@q»</h3>

<div class="row">
    <div class="col-md-8">
        <h5>Изображения</h5>
        <div class="pin-grid">
            @for (int i = 0; i < 8; i++)
            {
                <div class="pin-card">
                    <img src="https://picsum.photos/seed/s@i/600/400" />
                </div>
            }
        </div>
    </div>
    <div class="col-md-4">
        <h5>Пользователи</h5>
        <ul class="list-group">
            @for (int i = 0; i < 4; i++)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    user_search@i
                    <button class="btn btn-sm btn-outline-primary">Подписаться</button>
                </li>
            }
        </ul>
    </div>
</div>