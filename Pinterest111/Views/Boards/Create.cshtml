@model Pinterest111.Models.BoardCreateViewModel
@{
    ViewData["Title"] = "Создать доску";
}

<h3 class="mb-3">Создать доску</h3>

<form asp-controller="Boards" asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger mb-2"></div>

    <div class="mb-2">
        <input asp-for="Title" class="form-control" placeholder="Название доски" />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>

    <div class="mb-2">
        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Описание (необязательно)"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Создать</button>
</form>