@{
    ViewData["Title"] = "Создать доску";
}

<h3>Создать доску (UI only)</h3>

<form onsubmit="return false;">
    <div class="mb-2">
        <input class="form-control" placeholder="Название доски" />
    </div>
    <div class="mb-2">
        <textarea class="form-control" rows="3" placeholder="Описание (опционально)"></textarea>
    </div>
    <div class="d-grid">
        <button class="btn btn-primary">Создать</button>
    </div>
</form>