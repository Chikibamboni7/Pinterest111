@model List<Pinterest111.Models.Board>
@{
    ViewData["Title"] = "Доски";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Доски</h3>
    <a class="btn btn-primary" asp-controller="Boards" asp-action="Create">Создать доску</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Досок пока нет.</p>
}
else
{
    <div class="row">
        @foreach (var b in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card p-3">
                    <h6 class="mb-1"><a asp-action="Details" asp-route-id="@b.Id">@b.Title</a></h6>
                    <div class="text-muted small">@b.Description</div>
                    <div class="mt-2 small text-muted">@b.PinIds?.Count ?? 0 items • @b.Author</div>
                </div>
            </div>
        }
    </div>
}