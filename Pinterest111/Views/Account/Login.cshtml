@model Pinterest111.Models.LoginViewModel
@{
    ViewData["Title"] = "Вход";
}

<div class="row justify-content-center" style="min-height:70vh; align-items:center;">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <h3 class="mb-3 text-center">Войти в Pinterest111</h3>

                <form asp-controller="Account" asp-action="Login" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="Identifier" class="form-label"></label>
                        <input asp-for="Identifier" class="form-control" placeholder="Email или username" />
                        <span asp-validation-for="Identifier" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" placeholder="Пароль" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <div class="d-grid mb-2">
                        <button type="submit" class="btn btn-primary">Войти</button>
                    </div>

                    <div class="d-flex justify-content-center">
                        <a asp-controller="Register" asp-action="Index">Создать аккаунт</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
